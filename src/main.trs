func min(a, b) {
    if a < b {
        return a;
    }

    return b;
}

func segment(n, length) {
    if n == 0 {
    forward length;
    return;
    }

    l = (length / 3);

    segment(n - 1, l);
    left 60;
    segment(n - 1, l);
    right 120;
    segment(n - 1, l);
    left 60;
    segment(n - 1, l);
}

func triangle(n, length) {
    left 60;
    segment(n, length);
    right 120;
    segment(n, length);
    right 120;
    segment(n, length);
    left 180;
}

i = min(3, 5);

while i < 6 {
    triangle(i, 400);
    i = i + 1;
}
