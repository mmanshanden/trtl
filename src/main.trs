func min(a, b) {
    if a < b {
        return a;
    }

    return b;
}

func straight(n, length) {
    if n == 0 {
        forward length;
        return;
    }

    l = (length / 3);

    straight(n - 1, l);
    left 60;
    straight(n - 1, l);
    right 120;
    straight(n - 1, l);
    left 60;
    straight(n - 1, l);
}

func triangle(n, length) {
    left 60;
    straight(n, length);
    right 120;
    straight(n, length);
    right 120;
    straight(n, length);
    left 180;
}

i = 5;

while 1 > 0 {
    triangle(i, 300);
}