{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dev-server",
            "command": "npm run dev",
            "type": "shell",
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}/web",
            },
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 0,
                            "location": 2,
                            "message": 0
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".",
                        "endsPattern": ".",
                    }
                }
            ]
        }
    ]
}