{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-wasm",
            "command": "cargo build --target wasm32-unknown-unknown --release",
            "type": "shell"
        },
        {
            "label": "start-dev-server",
            "command": "npx vite --port 4000",
            "type": "shell",
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}/web",
            },
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 0,
                            "location": 0,
                            "message": 0
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "dev",
                        "endsPattern": "ready in",
                    }
                }
            ]
        },
        {
            "label": "start-web",
            "dependsOn": [
                "build-wasm",
                "start-dev-server"
            ],
            "dependsOrder": "parallel"
        },
        {
            "label": "stop-dev-server",
            "type": "shell",
            "command": "npx kill-port 4000",
            "options": {
                "cwd": "${workspaceFolder}/web",
            }
        },
    ]
}